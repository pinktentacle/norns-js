node_modules/
dist/
build/
.cache/
third_party/
*.wasm
*.o
*.a
.DS_Store

# 34 community norns scripts, cloned for reference and later as real-world
# targets (R-02: unmodified community scripts run). Each is its own git
# repository, 91 MB in all, and tracking them here would record 34 gitlinks
# that point at nothing a clone could resolve. See its README for how it was
# fetched.
community patches/

# Generated from "community patches/" by tools/build-dust.mjs. 5.4 MB of
# other people's scripts, derived from a directory that is itself ignored.
# Rebuild with `npm run dust`.
public/dust.json

# Generated by tools/build-clock-worklet.mjs (`npm run clock`).
public/clock-processor.js

# Copied from third_party/ by tools/build-audio-assets.mjs (`npm run audio`).
# 6 MB of SuperCollider wasm and the norns class library.
public/sclang/
public/scsynth/
# E9-223 — the 128 MB scsynth, loaded when a device refuses the 512 MB one
public/scsynth-small/
# E9-275 — the sox command, built by tools/sox/build.sh
public/sox/
public/norns-sc/

# Generated by tools/build-crone-worklet.mjs (`npm run crone:worklet`) from
# src/crone/ plus the emscripten build. crone.wasm is already covered by the
# *.wasm rule above; this is the 70 KB classic script it is loaded by.
public/crone-worklet.js

# Generated by tools/build-dust.mjs alongside dust.json: the sound files that
# scripts ship, kept out of line because amen alone is 11 MB and most
# sessions never read one. The manifest says where they are; the VFS fetches
# a file the first time something actually wants its bytes.
public/dust-bin/
public/dust-assets.json

# Copied from tools/pack/build by tools/build-audio-assets.mjs (`npm run
# audio`): sclang's class library as an archive, because the browser build
# has no `--preload-file`. Rebuild it with `node tools/pack/pack-classlib.mjs`.
public/pack/

# E7 export artefacts (tools/serve.mjs and the README are the sources)
build-portable/
norns-js-portable.zip

# the desktop shell build (D-03)
desktop/payload/
desktop/out/

# E9-63 — the spike's working copy of fengari, which is reproducible from
# the published package plus spike/lua64/fengari-64bit.patch. The patch is
# tracked; 17,000 lines of somebody else's MIT source are not.
spike/lua64/fengari-src/

# E9-71 — the catalogue cache `tools/fetch-catalogue.mjs` writes, and what
# `tools/build-blockers.mjs` reads: a listing per repository and every .lua,
# .sc, .scd, .json, .md and .sh in all 354 of them. About 3600 files of other
# people's scripts, fetched from jsDelivr and reproducible in one command.
# The TABLE it produces is tracked (public/community-blockers.json); the
# quarry it was cut from is not.
tools/listings.json
tools/files/

# A zip of a tracked script is a copy of a tracked script. One appeared in
# `tools/` while the publishing runbook was being written — handy for
# carrying to another machine, and swept into a commit by `git add -A`
# before anybody noticed. The file stays; the tracking does not.
tools/*.zip

# E9-117 — the Lua interpreter, built by tools/lua53/build.sh. Generated,
# like every other wasm artefact here: `npm run lua` makes it.
src/lua/lua53/

# E9-273 - wrangler's build scratch: release-kit/4-cloudflare.ps1 deploys from the
# repository folder and wrangler writes .wrangler/tmp/ there. 0.1.15 committed it.
.wrangler/

+// norns-js: the same equal-power law, with the two ends taken out of the
+// transcendental. `fade_` is a linear ramp that SubHead clamps at 0 and 1,
+// so outside an actual crossfade both arguments are exactly one of those —
+// and a crossfade is `fade_time` long, about 480 samples against a loop of
+// tens of thousands.
+//
+// EXACT, not approximate: sinf(0.f) is 0.f, and sinf of the float nearest
+// pi/2 is 1.f, so the two short-circuits return what the call returned.
+// Anything strictly between still goes through sinf. Checked by rendering
+// four hundred blocks through both builds and comparing every sample.
+static inline float softcutFadeSin(float a) {
+        if (a <= 0.f) return 0.f;
+        if (a >= 1.f) return 1.f;
+        return sinf(a * (float)M_PI_2);
+}
+
 sample_t ReadWriteHead::mixFade(sample_t x, sample_t y, float a, float b) {
-        return x * sinf(a * (float)M_PI_2) + y * sinf(b * (float) M_PI_2);
+        return x * softcutFadeSin(a) + y * softcutFadeSin(b);
 }
 

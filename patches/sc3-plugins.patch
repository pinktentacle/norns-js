+	// norns-js E9-29: was `if(0<=bufnum<= world->mNumSndBufs)`, which clang
+	// refuses outright. It parses as `(0<=bufnum) <= mNumSndBufs` — a 0 or
+	// a 1 compared against a buffer COUNT, so it is true for every bufnum
+	// including the out-of-range ones this line exists to reject. The
+	// upper bound is `<`, not `<=`: mNumSndBufs is a count, and the last
+	// valid index is one below it.
+	if(bufnum >= 0 && bufnum < world->mNumSndBufs) {
 		SndBuf * buf;
 

@@ -234,6 +234,55 @@ endif()
 
 if(STATIC_PLUGINS)
     target_compile_definitions(libscsynth PRIVATE "-DSTATIC_PLUGINS")
+    # norns-js: tells SC_StaticPlugins.h to declare and call the sc3-plugins
+    # load functions. Same variable the plugins directory tests, so the two
+    # cannot disagree about whether they were built.
+    if(SC3_PLUGINS_DIR AND EXISTS "${SC3_PLUGINS_DIR}")
+        target_compile_definitions(libscsynth PRIVATE "-DSC3_PLUGINS")
+        if(SC3_FAUST_WRAPPER_DIR AND EXISTS "${SC3_FAUST_WRAPPER_DIR}")
+            target_compile_definitions(libscsynth PRIVATE "-DSC3_FAUST_PLUGINS")
+        endif()
+        # norns-js E9-29: PitchDetection and NCAnalysisUGens, which exist
+        # only when a wasm fftw3f was built. Same variable the plugins
+        # directory tests, for the same reason as above.
+        if(FFTW3F_LIB AND EXISTS "${FFTW3F_LIB}")
+            target_compile_definitions(libscsynth PRIVATE "-DSC3_FFTW")
+        endif()
+        # norns-js E9-30: StkUGens and StkInst, from the STK that
+        # sc3-plugins vendors. Tested on the same file the plugins
+        # directory tests.
+        if(EXISTS "${SC3_PLUGINS_DIR}/../external_libraries/stk/include/Stk.h")
+            target_compile_definitions(libscsynth PRIVATE "-DSC3_STK")
+        endif()
+    endif()
+    # norns-js E9-36/E9-40: the single-plugin repositories -- the three
+    # PTR oscillators and ByteBeat -- vendored one directory each.
+    if(SC_EXTRA_DIR AND EXISTS "${SC_EXTRA_DIR}")
+        target_compile_definitions(libscsynth PRIVATE "-DSC_EXTRA_PLUGINS")
+    endif()
+    # norns-js E9-35: PortedPlugins, its own checkout and its own variable.
+    if(PORTED_PLUGINS_DIR AND EXISTS "${PORTED_PLUGINS_DIR}")
+        target_compile_definitions(libscsynth PRIVATE "-DPORTED_PLUGINS")
+        # E9-58: fourteen of its plugins want a library of their own, and
+        # the declarations below must agree with what was actually built —
+        # so each is tested by the same file the plugins directory tests.
+        if(DAISYSP_DIR AND EXISTS "${DAISYSP_DIR}/Source/daisysp.h")
+            target_compile_definitions(libscsynth PRIVATE "-DPP_DAISYSP")
+        endif()
+        if(EIGEN_DIR AND EXISTS "${EIGEN_DIR}/Eigen/Dense")
+            target_compile_definitions(libscsynth PRIVATE "-DPP_EIGEN")
+        endif()
+    endif()
+    # norns-js: mi-UGens, same arrangement and the same variable.
+    if(MI_UGENS_DIR AND EXISTS "${MI_UGENS_DIR}")
+        target_compile_definitions(libscsynth PRIVATE "-DMI_UGENS")
+        # MiBraids rides on its own submodule. Tested here by the same file
+        # the plugins directory tests, so the declaration and the archive
+        # cannot disagree about whether MiBraids was built.
+        if(EXISTS "${MI_UGENS_DIR}/projects/MiBraids/libsamplerate/src/samplerate.c")
+            target_compile_definitions(libscsynth PRIVATE "-DMI_BRAIDS")
+        endif()
+    endif()
     # add plugin archives
     target_link_libraries(libscsynth PRIVATE ${static_plugins})
 endif()
@@ -326,8 +375,55 @@ elseif(AUDIOAPI STREQUAL webaudio)
         --bind -sMODULARIZE=1 -sEXPORT_ES6=1 -sEXPORT_NAME='ScSynth'
         --pre-js "${CMAKE_SOURCE_DIR}/platform/wasm/scsynth.pre.js"
         -sEXPORTED_FUNCTIONS=['_malloc','_free','_webOscBindingAnchor']
-        -sEXPORTED_RUNTIME_METHODS=['ccall','cwrap','HEAPU8','UTF8ToString']
+        # norns-js E9-30: FS as well. This list OVERRIDES the global
+        # `-sEXPORTED_RUNTIME_METHODS=FS,HEAPU8` in CMAKE_EXE_LINKER_FLAGS,
+        # so without naming FS here the server's filesystem is unreachable
+        # from the page — and STK's wavetables have to be written into the
+        # SERVER's filesystem, not sclang's, because the UGen that reads
+        # them runs there.
+        -sEXPORTED_RUNTIME_METHODS=['ccall','cwrap','HEAPU8','UTF8ToString','FS']
+        # norns-js E9-40: exception CATCHING, for ByteBeat and nothing
+        # else. Emscripten links libc++ and libc++abi in their -noexcept
+        # variants by default, so a throw in any translation unit ends at
+        # abort() whatever that unit was compiled with -- measured: one
+        # malformed bytebeat expression took the whole DSP graph down,
+        # a plain sine included, while sclang went on answering.
+        #
+        # It costs nothing elsewhere: only the files compiled with
+        # -fexceptions -- ByteBeat.cpp, lex.cpp, parse.cpp -- get landing
+        # pads (and SC_GraphDef.cpp since E9-242, below).
+        -fexceptions
     )
+    # norns-js E9-242: and SC_GraphDef.cpp, so `GraphDef_Recv`'s own
+    # try/catch is there. Without landing pads the catch is dropped, and a
+    # SynthDef the server refuses ("exceeded number of interconnect
+    # buffers", "UGen not installed") kills the NRT thread instead of
+    # printing one line: every later /d_recv and /sync of the session then
+    # waits for ever (measured: downtown's engine, then nothing loads).
+    # Upstream compiles everything this way; the cost is in def loading,
+    # which never runs on the audio thread.
+    set_source_files_properties(SC_GraphDef.cpp PROPERTIES COMPILE_OPTIONS -fexceptions)
+    # E9-247: and SC_SequencedCommand.cpp, for the same reason. Its async
+    # commands that read files (/d_load, /d_loadDir, /b_allocRead...) throw
+    # on a missing file and catch it themselves, answering /fail. Without
+    # landing pads that catch is gone too: grains' cached-def `/d_loadDir`
+    # of a folder the server cannot see stopped the server for the session.
+    set_source_files_properties(SC_SequencedCommand.cpp PROPERTIES COMPILE_OPTIONS -fexceptions)
+    # norns-js: scsynth's heap is FIXED — the memory is shared with the audio
+    # worklet, so initial and maximum are the same and it cannot grow. The
+    # emscripten default is 16 MB, which has to hold 2.7 MB of code and
+    # static data, realTimeMemorySize (norns asks for 8 MB), 1024 buffers and
+    # every sample a script loads. It was already tight before sc3-plugins
+    # was compiled in; afterwards it aborts with OOM on every boot.
+    #
+    # It cannot be raised at instantiation: the module declares its maximum
+    # at link time, and a larger Memory fails validation with
+    # "memory import has a larger maximum size 2048 than the module's
+    # declared maximum 256". So it is set here, and only when asked for, so
+    # an unconfigured build is exactly what upstream produces.
+    if(SC_WASM_INITIAL_MEMORY)
+        target_link_options(scsynth PRIVATE "-sINITIAL_MEMORY=${SC_WASM_INITIAL_MEMORY}")
+    endif()
     if(WASM_DEBUG)
         target_compile_options(scsynth PRIVATE -pthread -g)
         target_compile_options(libscsynth PRIVATE -pthread -g)

+# --- norns-js E9-36/E9-40: single-plugin repositories -------------------
+#
+# Upstream packs ship one repository per UGen, each with its own CMake and
+# its own `.so`. Here they are all one binary, so they are one list: a
+# name, then the sources, and the set is built like any other plugin.
+#
+# THE PTR OSCILLATORS. `bitters`, `lamination`, `faeng` and
+# `schicksalslied` each bundle an ARM `.so` and copy it into Extensions --
+# which is the half-state E9-33 now refuses, so until this they could not
+# have them at all.
+#
+# FINDING THE SOURCE WAS THE WORK. The scripts' author published one
+# repository per oscillator, and the account was renamed: `ryleelyman`
+# answers 404 and the repositories live under `robbielyman`. GitHub's code
+# search needs a token, so this was found by asking the API who owns
+# `ryleelyman/bitters` -- it answers `robbielyman` -- and listing that
+# account: FormantTriPTR, pulseptr, triangleptr.
+#
+# BYTEBEAT is midouest/bytebeat: one UGen, plus a small lexer and parser
+# for the expression language it evaluates per sample. Those two throw
+# `invalid_argument` on a malformed expression and ByteBeat.cpp catches
+# it, so these three files -- and only these three -- are compiled with
+# `-fexceptions`. Without it emscripten drops the catch and a typo in a
+# bytebeat expression aborts the whole server.
+if(SC_EXTRA_DIR AND EXISTS "${SC_EXTRA_DIR}")
+    message(STATUS "single-plugin repositories: building from ${SC_EXTRA_DIR}")
+    set(extra_targets
+        "FormantTriPTR|FormantTriPTR.cpp"
+        "PulsePTR|PulsePTR.cpp"
+        "TrianglePTR|TrianglePTR.cpp"
+        "ByteBeat|ByteBeat.cpp,lex.cpp,parse.cpp")
+    foreach(entry ${extra_targets})
+        string(REPLACE "|" ";" parts "${entry}")
+        list(GET parts 0 x_name)
+        list(GET parts 1 x_srcs)
+        string(REPLACE "," ";" x_srcs "${x_srcs}")
+        set(x_full "")
+        foreach(src ${x_srcs})
+            list(APPEND x_full "${SC_EXTRA_DIR}/${x_name}/${src}")
+        endforeach()
+        add_library(x_${x_name} ${TYPE} ${x_full})
+        target_link_libraries(x_${x_name} PRIVATE plugin_common)
+        target_include_directories(x_${x_name} PRIVATE "${SC_EXTRA_DIR}/${x_name}")
+        # Each repository has its own file-level `ft`, and one symbol table
+        # cannot hold four of them.
+        set_source_files_properties("${SC_EXTRA_DIR}/${x_name}/${x_name}.cpp"
+            PROPERTIES COMPILE_DEFINITIONS "ft=x_ft_${x_name}")
+        if(x_name STREQUAL "ByteBeat")
+            # -pthread for the same reason the rest of the binary has it:
+            # wasm-ld refuses --shared-memory for an object without the
+            # atomics and bulk-memory features, and the exception tables
+            # -fexceptions emits are exactly such a data segment.
+            target_compile_options(x_${x_name} PRIVATE -fexceptions -pthread)
+        endif()
+        list(APPEND plugins x_${x_name})
+    endforeach()
+endif()

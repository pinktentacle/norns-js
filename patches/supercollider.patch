@@ -97,8 +97,11 @@ WorldOptions toScWorld(ScWebAudioOptions* userOptions) {
     options.mRealTime = 1;
     options.mSharedMemoryID = 0;
     options.mVerbosity = 0;
-    // @todo make this user configurable?
-    options.mMaxLogins = 4;
+    // norns-js E9-229 — ONE login, as a norns has (sclang's default `-l 1`).
+    // sclang divides every allocator by the logins the server reports, so

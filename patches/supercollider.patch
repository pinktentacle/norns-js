+# --- norns-js E9-35: PortedPlugins, compiled IN -------------------------
+#
+# The pack `amenbreak` tries to `wget` from
+# schollz/tapedeck/releases/download/PortedPlugins, which is a binary
+# release built for the Raspberry Pi. The SOURCE is schollz/portedplugins,
+# a fork of madskjeldgaard/portedplugins carrying Fverb2 and XPlayBuf, and
+# it is what this builds from.
+#
+# Seven catalogue scripts wait on it: amenbreak, tapedeck, rachim, twins,
+# Eastwind, graintopia and zxcvbn want `AnalogTape`, `AnalogChew`,
+# `AnalogDegrade`, `AnalogLoss`, `AnalogVintageDistortion`, `Fverb` and
+# `Fverb2`. `VAKorg35`, which docs/11-MISSING.md listed as missing from
+# sc3-plugins, is here too.
+#
+# `odinfilters/*.cpp` holds out-of-line definitions that five of the
+# filters include by header, so it is ONE archive they share rather than a
+# copy each. `mutated/` is not built: Rongs.hpp `#include`s
+# `../mutated/mi-modal.cpp` directly, so compiling it again would be a
+# second copy of the same symbols.
+if(PORTED_PLUGINS_DIR AND EXISTS "${PORTED_PLUGINS_DIR}")
+    message(STATUS "PortedPlugins: building from ${PORTED_PLUGINS_DIR}")
+    add_library(pp_odin ${TYPE}
+        "${PORTED_PLUGINS_DIR}/odinfilters/DiodeFilter.cpp"
+        "${PORTED_PLUGINS_DIR}/odinfilters/Korg35Filter.cpp"
+        "${PORTED_PLUGINS_DIR}/odinfilters/LadderFilter.cpp"
+        "${PORTED_PLUGINS_DIR}/odinfilters/SEMFilter12.cpp"
+        "${PORTED_PLUGINS_DIR}/odinfilters/VAOnePoleFilter.cpp")
+    target_link_libraries(pp_odin PRIVATE plugin_common)
+    # E9-58 — THE OTHER FOURTEEN, which wanted two libraries this build did
+    # not have. `daisysp` for AnalogBassDrum, AnalogSnareDrum, BLOsc,
+    # DCompressor, HarmonicOsc, NeoFormant, NeoVarSawOsc, OscBank,
+    # Resonator, StringVoice, VarShapeOsc, VosimOsc and ZOsc; `Eigen` for
+    # ChowDSP's GenSVF and the Werner filter that includes it. Their own
+    # build downloads both through CPM at configure time, which a wasm
+    # cross-build cannot do; both are vendored under third_party now and
+    # passed in, and a build without them is exactly what it was before.
+    #
+    # No catalogue script was waiting on them — that was measured, and
+    # said so in the commit that left them out. They are here because a
+    # UGen a pack ships and this server does not have is a gap whether or
+    # not somebody has walked into it yet: `scsynth` throws on a SynthDef
+    # naming a UGen it lacks, and with exceptions off that throw takes the
+    # audio thread with it for the rest of the session.
+    if(DAISYSP_DIR AND EXISTS "${DAISYSP_DIR}/Source/daisysp.h")
+        file(GLOB_RECURSE daisysp_srcs "${DAISYSP_DIR}/Source/*.cpp")
+        # DaisySP-LGPL is DaisySP's OWN submodule, and two of these
+        # plugins are inside it: `BLOsc` wants daisysp::BlOsc and
+        # `DCompressor` daisysp::Compressor, both moved out of the MIT
+        # tree into an LGPL-2.1 one. It is a separate licence and so a
+        # separate decision -- recorded in LICENCES.md -- and a
+        # checkout without the submodule simply builds the other eleven.
+        file(GLOB_RECURSE daisysp_lgpl_srcs "${DAISYSP_DIR}/DaisySP-LGPL/Source/*.cpp")
+        list(APPEND daisysp_srcs ${daisysp_lgpl_srcs})
+        add_library(pp_daisysp ${TYPE} ${daisysp_srcs})
+        target_include_directories(pp_daisysp PUBLIC
+            "${DAISYSP_DIR}/Source"
+            "${DAISYSP_DIR}/Source/Control"
+            "${DAISYSP_DIR}/Source/Drums"
+            "${DAISYSP_DIR}/Source/Dynamics"
+            "${DAISYSP_DIR}/Source/Effects"
+            "${DAISYSP_DIR}/Source/Filters"
+            "${DAISYSP_DIR}/Source/Noise"
+            "${DAISYSP_DIR}/Source/PhysicalModeling"
+            "${DAISYSP_DIR}/Source/Sampling"
+            "${DAISYSP_DIR}/Source/Synthesis"
+            "${DAISYSP_DIR}/Source/Utility"
+            "${DAISYSP_DIR}/DaisySP-LGPL/Source"
+            "${DAISYSP_DIR}/DaisySP-LGPL/Source/Control"
+            "${DAISYSP_DIR}/DaisySP-LGPL/Source/Dynamics"
+            "${DAISYSP_DIR}/DaisySP-LGPL/Source/Effects"
+            "${DAISYSP_DIR}/DaisySP-LGPL/Source/Filters"
+            "${DAISYSP_DIR}/DaisySP-LGPL/Source/PhysicalModeling"
+            "${DAISYSP_DIR}/DaisySP-LGPL/Source/Synthesis"
+            "${DAISYSP_DIR}/DaisySP-LGPL/Source/Utility")
+        message(STATUS "PortedPlugins: DaisySP from ${DAISYSP_DIR}")
+        set(pp_daisy_users
+            AnalogBassDrum AnalogSnareDrum BLOsc DCompressor HarmonicOsc
+            NeoFormant NeoVarSawOsc OscBank Resonator StringVoice
+            VarShapeOsc VosimOsc ZOsc)
+    else()
+        message(STATUS "PortedPlugins: no DaisySP, thirteen plugins skipped")
+        set(pp_daisy_users "")
+    endif()
+    set(pp_odin_users VA1Pole VADiodeFilter VAKorg35 VALadder VASEM12)
+    set(pp_targets
+        "AnalogFoldOsc|AnalogFoldOsc/AnalogFoldOsc.cpp,AnalogFoldOsc/buchla259cell.cpp,AnalogFoldOsc/buchla259waveshaper.cpp"
+        "Chen|Chen/Chen.cpp"
+        "ChowDSP|ChowDSP/AnalogChew.cpp,ChowDSP/AnalogDegrade.cpp,ChowDSP/AnalogLoss.cpp,ChowDSP/AnalogPhaser.cpp,ChowDSP/AnalogPhaserMod.cpp,ChowDSP/AnalogPulseShaper.cpp,ChowDSP/AnalogTape.cpp,ChowDSP/AnalogVintageDistortion.cpp,ChowDSP/BaxandallEQ.cpp,ChowDSP/PhasorModal.cpp"
+        "LPG|LPG/LPG.cpp"
+        "LockhartWavefolder|LockhartWavefolder/LockhartCell.cpp,LockhartWavefolder/LockhartWavefolder.cpp"
+        "NonlinearFilter|NonlinearFilter/EQFilter.cpp,NonlinearFilter/NonlinearFilter.cpp"
+        "Rongs|Rongs/Rongs.cpp"
+        "VA1Pole|VA1Pole/VA1Pole.cpp"
+        "VADiodeFilter|VADiodeFilter/VADiodeFilter.cpp"
+        "VAKorg35|VAKorg35/VAKorg35.cpp"
+        "VALadder|VALadder/VALadder.cpp"
+        "VASEM12|VASEM12/VASEM12.cpp"
+        "VadimFilter|VadimFilter/VadimFilter.cpp"
+        "XPlayBuf|XPlayBuf/XPlayBuf.cpp"
+    )
+    # E9-58 — the DaisySP ones, one source each, appended only when the
+    # library is there so the list above stays the no-dependency build.
+    foreach(pp_d ${pp_daisy_users})
+        list(APPEND pp_targets "${pp_d}|${pp_d}/${pp_d}.cpp")
+    endforeach()
+    # Werner lives inside ChowDSP's directory and is the only thing in this
+    # pack that needs Eigen; ChowDSP's own target above does not include it.
+    if(EIGEN_DIR AND EXISTS "${EIGEN_DIR}/Eigen/Dense")
+        list(APPEND pp_targets "Werner|ChowDSP/Werner.cpp")
+        message(STATUS "PortedPlugins: Eigen from ${EIGEN_DIR}")
+    else()
+        message(STATUS "PortedPlugins: no Eigen, Werner skipped")
+    endif()
+    foreach(entry ${pp_targets})
+        string(REPLACE "|" ";" parts "${entry}")
+        list(GET parts 0 pp_name)
+        list(GET parts 1 pp_srcs_raw)
+        string(REPLACE "," ";" pp_srcs "${pp_srcs_raw}")
+        set(pp_full "")
+        foreach(src ${pp_srcs})
+            list(APPEND pp_full "${PORTED_PLUGINS_DIR}/${src}")
+        endforeach()
+        add_library(pp_${pp_name} ${TYPE} ${pp_full})
+        target_link_libraries(pp_${pp_name} PRIVATE plugin_common)
+        target_include_directories(pp_${pp_name} PRIVATE
+            "${PORTED_PLUGINS_DIR}/${pp_name}" "${PORTED_PLUGINS_DIR}")
+        if(pp_name IN_LIST pp_odin_users)
+            target_link_libraries(pp_${pp_name} PRIVATE pp_odin)
+        endif()
+        if(pp_name IN_LIST pp_daisy_users)
+            target_link_libraries(pp_${pp_name} PRIVATE pp_daisysp)
+            # BLOsc and DCompressor name daisysp::BlOsc and
+            # daisysp::Compressor, which today's DaisySP keeps in its
+            # LGPL submodule — and `daisysp.h`, the only header they
+            # include, does not pull that one in. A forced include puts
+            # the declarations where the plugin expects them without
+            # editing somebody else's source.
+            if(pp_name STREQUAL "BLOsc" OR pp_name STREQUAL "DCompressor")
+                target_compile_options(pp_${pp_name} PRIVATE
+                    "-include" "daisysp-lgpl.h")
+            endif()
+        endif()
+        if(pp_name STREQUAL "Werner")
+            target_include_directories(pp_${pp_name} PRIVATE
+                "${EIGEN_DIR}" "${PORTED_PLUGINS_DIR}/ChowDSP")
+        endif()
+        # Two of them write a non-static `InterfaceTable* ft`, the same
+        # shape sc3-plugins had. One name per file, as there.
+        # `HysteresisProcessing.cpp` is `#include`d by both AnalogTape.hpp
+        # and AnalogLoss.hpp — the same shape as DWGUGens — so it is not
+        # compiled on its own, and the class it defines gets one name per
+        # translation unit. Found by the linker, which reported it twice.
+        set(pp_uniquify ft HysteresisProcessing SolverType)
+        foreach(one_src ${pp_full})
+            get_filename_component(one_stem "${one_src}" NAME_WE)
+            set(one_defs "")
+            foreach(sym ${pp_uniquify})
+                list(APPEND one_defs "${sym}=pp_${sym}_${one_stem}")
+            endforeach()
+            set_source_files_properties("${one_src}" PROPERTIES
+                COMPILE_DEFINITIONS "${one_defs}")
+        endforeach()
+        list(APPEND plugins pp_${pp_name})
+    endforeach()
+
+    # Fverb and Fverb2 are Faust-generated: a bare `load(InterfaceTable*)`
+    # and a `class mydsp` at global scope, which is the shape that needs a
+    # namespace of its own. Same wrappers as JPverb and Greyhole — see
+    # tools/sclang/sc3-faust for why a plain link would silently give one
+    # plugin the other's DSP.
+    if(SC3_FAUST_WRAPPER_DIR AND EXISTS "${SC3_FAUST_WRAPPER_DIR}/Fverb_static.cpp")
+        foreach(pp_faust Fverb Fverb2)
+            add_library(pp_${pp_faust} ${TYPE}
+                "${SC3_FAUST_WRAPPER_DIR}/${pp_faust}_static.cpp")
+            target_link_libraries(pp_${pp_faust} PRIVATE plugin_common)
+            target_include_directories(pp_${pp_faust} PRIVATE
+                "${PORTED_PLUGINS_DIR}/${pp_faust}")
+            list(APPEND plugins pp_${pp_faust})
+        endforeach()
+    endif()
+endif()

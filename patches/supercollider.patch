diff --git a/server/plugins/CMakeLists.txt b/server/plugins/CMakeLists.txt
index e54fed7713d40ecd17e094383baa67b8c1bde745..6822177fbd2209af50f5cfa170dfe928416d8f6d 100644
--- a/server/plugins/CMakeLists.txt
+++ b/server/plugins/CMakeLists.txt
@@ -107,6 +107,768 @@ foreach(plugin_src ${plugin_sources})
     endif()
 endforeach()
 
+# --- norns-js: sc3-plugins, compiled IN ---------------------------------
+#
+# wasm has no dlopen, so a plugin that is not on the link line does not
+# exist. `STATIC_PLUGINS` is already ON for emscripten (top-level
+# CMakeLists.txt:213), and `PluginLoad(X)` then expands to `X_Load`, so an
+# out-of-tree UGen set needs exactly two things: a target here, and its
+# `X_Load` called from SC_StaticPlugins.h.
+#
+# Only the sets norns' community scripts actually reach are built. A static
+# scan of ~/dust/code found 15 of 51 .sc files using one of: Decimator and
+# the rest of DistortionUGens, DFM1 (TJUGens), SVF (BlackrainUGens) and
+# MdaPiano (MdaUGens).
+#
+# DEINDUGens (JPverb, Greyhole) is here too, but through WRAPPERS. Those two
+# are Faust-generated and are not written for a static link: each ends with a
+# bare `load()` rather than `PluginLoad(X)`, and each defines `class mydsp`
+# with virtual functions at global scope, so their vtables are COMDAT symbols
+# the linker would silently fold into one — a JPverb running Greyhole's DSP,
+# with nothing to say so. `tools/sclang/sc3-faust/*.cpp` gives each its own
+# namespace and the `X_Load` name the static loader expects.
+if(SC3_PLUGINS_DIR AND EXISTS "${SC3_PLUGINS_DIR}")
+    message(STATUS "sc3-plugins: building from ${SC3_PLUGINS_DIR}")
+    set(sc3_plugin_targets
+        "DistortionUGens|DistortionUGens/DistortionUGens.cpp"
+        "TJUGens|TJUGens/TJUGens.cpp,TJUGens/Dfm1.cpp,TJUGens/Dfm1Lut.cpp,TJUGens/NoiseGen.cpp"
+        "BlackrainUGens|BlackrainUGens/BlackrainUGens.cpp"
+        "MdaUGens|MdaUGens/MdaUGens.cpp"
+        # Coyote (oooooo) and EnvFollow (pedalboard). Their CLASSES were
+        # shipped before their UGens were, which is the failure the class
+        # list above warns about: sclang resolves the name, the server
+        # throws on the def, and with exceptions off that aborts the
+        # thread handling /d_recv for the rest of the session.
+        # BatPVUgens.cpp is left out: it needs the FFT interface table.
+        "BatUGens|BatUGens/BatUGens.cpp"
+        "SLUGens|SLUGens/SLUGens.cpp"
+        # --- E9-28: the rest of what norns has -----------------------------
+        #
+        # norns builds the WHOLE of sc3-plugins (its Dockerfile:131 clones
+        # the repository and installs every target), so every name below is
+        # one a catalogue script may use and get on hardware. The six above
+        # were chosen by a scan of the 35 BUNDLED scripts; these were chosen
+        # by a scan of all 354, counting scripts per UGen:
+        #
+        #   MCLDUGens                13 scripts  SawDPW[9] ArrayMin[2] ...
+        #   BhobUGens                10          MoogLadder[8] RLPFD ...
+        #   AntiAliasingOscillators   5          DPW3Tri
+        #   JoshUGens                 3          PV_Freeze[2] WarpZ
+        #   SkUGens                   3          FM7
+        #   SCMIRUGens                2          OnsetStatistics
+        #   BerlachUGens, LoopBufUGens, NHUGens, RFWUGens
+        #                             1 each     BLBufRd, LoopBuf, NHHall,
+        #                                        AverageOutput
+        "AntiAliasingOscillators|AntiAliasingOscillators/AntiAliasingOscillators.cpp"
+        "MCLDUGens|MCLDUGens/MCLDBufferUGens.cpp,MCLDUGens/MCLDCepstrumUGens.cpp,MCLDUGens/MCLDChaosUGens.cpp,MCLDUGens/MCLDDistortionUGens.cpp,MCLDUGens/MCLDFFTUGens.cpp,MCLDUGens/MCLDFilterUGens.cpp,MCLDUGens/MCLDGetenvUGen.cpp,MCLDUGens/MCLDOscUGens.cpp,MCLDUGens/MCLDPollUGens.cpp,MCLDUGens/MCLDSOMUGens.cpp,MCLDUGens/MCLDSparseUGens.cpp,MCLDUGens/MCLDTreeUGens.cpp,MCLDUGens/MCLDTriggeredStatsUgens.cpp"
+        "BhobUGens|BhobUGens/BhobChaos.cpp,BhobUGens/BhobFFT.cpp,BhobUGens/BhobFilt.cpp,BhobUGens/BhobGrain.cpp,BhobUGens/BhobNoise.cpp"
+        "SkUGens|SkUGens/FM7.cpp"
+        "SCMIRUGens|SCMIRUGens/AttackSlope.cpp,SCMIRUGens/BeatStatistics.cpp,SCMIRUGens/Chromagram.cpp,SCMIRUGens/FeatureSave.cpp,SCMIRUGens/KeyClarity.cpp,SCMIRUGens/KeyMode.cpp,SCMIRUGens/OnsetStatistics.cpp,SCMIRUGens/SensoryDissonance.cpp"
+        # AmbisonicUGens.cpp is left out: it and JoshAmbiUGens.cpp both
+        # define `A2B_Ctor` and `Mirroring`, two plugins with one UGen
+        # name between them. Upstream builds each as its own .so and
+        # never has to choose; a static link does. JoshAmbi is the
+        # larger of the two (36 functions against 18) and is kept.
+        "JoshUGens|JoshUGens/JoshAmbiUGens.cpp,JoshUGens/JoshGrainUGens.cpp,JoshUGens/JoshPVUGens.cpp,JoshUGens/JoshUGens.cpp,JoshUGens/PermUGens.cpp"
+        "BerlachUGens|BerlachUGens/BerlachUGens.cpp"
+        "LoopBufUGens|LoopBufUGens/LoopBuf.cpp"
+        "NHUGens|NHUGens/NHHall.cpp"
+        "RFWUGens|RFWUGens/RFWUGens.cpp"
+        # And the rest that builds. norns has every set; these are the ones
+        # nothing in the catalogue names today but that a script could, and
+        # they cost one translation unit each. What is NOT here, and why,
+        # is in docs/11-MISSING.md.
+        "AuditoryModeling|AuditoryModeling/AuditoryModelingUGens.cpp,AuditoryModeling/MeddisHairCell.cpp,AuditoryModeling/SimpleHairCell.cpp"
+        "BBCut2UGens|BBCut2UGens/BBCut2UGens.cpp,BBCut2UGens/DrumTrack.cpp"
+        "BetablockerUGens|BetablockerUGens/betablocker/machine.cpp,BetablockerUGens/betablocker/thread.cpp,BetablockerUGens/BetablockerUGens.cpp"
+        "ConcatUGens|ConcatUGens/Concat.cpp"
+        "MembraneUGens|MembraneUGens/Membrane.cpp,MembraneUGens/Membrane_shape.c"
+        "QuantityUGens|QuantityUGens/QuantityUGens.cpp"
+        "RMEQSuiteUGens|RMEQSuiteUGens/RMEQSuite.cpp"
+        "SummerUGens|SummerUGens/SummerUGens.cpp"
+        "TagSystemUGens|TagSystemUGens/TagSystemUgens.cpp"
+        "VBAPUGens|VBAPUGens/VBAP.cpp"
+        "VOSIMUGens|VOSIMUGens/VOSIM.cpp"
+        # E9-29 — three sets whose only obstacle was a NAME.
+        #
+        # `PluginLoad(X)` pastes X into `X_Load`, and a macro cannot reach a
+        # pasted token, so these could not be renamed from here. They are
+        # renamed at the source instead and the change is carried in
+        # patches/sc3-plugins.patch: ChaosUGens said `Chaos`, which is
+        # SuperCollider's own core plugin, and said it TWICE (NoiseRing.cpp
+        # and PredPrey.cpp — upstream builds each file as its own shared
+        # object, so it never had to choose); GlitchUGens said `Filter`,
+        # also core's; Neuromodules said `TagSystem`, which TagSystemUGens
+        # already has. Nothing but the load symbol is touched.
+        "ChaosUGens|ChaosUGens/NoiseRing.cpp,ChaosUGens/PredPrey.cpp"
+        "GlitchUGens|GlitchUGens/GlitchUGens.cpp"
+        "Neuromodules|Neuromodules/Neuromodules.cpp"
+        # DWGBowed.cpp and DWGPlucked.cpp each `#include "dwglib/DWG.cpp"`,
+        # so that file must NOT also be compiled on its own: it would be a
+        # third copy of the helpers the uniquifying below already gives each
+        # translation unit its own name for. OteyPiano.cpp includes it too,
+        # across the tree, and gets its own copy the same way.
+        "DWGUGens|DWGUGens/DWGBowed.cpp,DWGUGens/DWGPlucked.cpp"
+        "OteyPianoUGens|OteyPianoUGens/dwgs.cpp,OteyPianoUGens/filter.cpp,OteyPianoUGens/hammer.cpp,OteyPianoUGens/OteyPiano.cpp,OteyPianoUGens/reverb.cpp"
+        # AYUGens carries its own copy of libayemu, at
+        # AYUGens/AY_libayemu — there is nothing to fetch. It was listed
+        # as "needs libayemu" only because the first survey looked for
+        # `.cpp` and ay8912 is a `.c`.
+        "AYUGens|AYUGens/AY_UGen.cpp,AYUGens/AY_libayemu/src/ay8912.c"
+    )
+
+    # --- E9-30: StkUGens and StkInst --------------------------------------
+    #
+    # STK IS VENDORED INSIDE sc3-plugins, at external_libraries/stk. These
+    # two were written down as "needs the STK library" on the strength of
+    # `#include <Clarinet.h>` failing, which was true and misleading: the
+    # header is right there, two directories up, and upstream's own
+    # CMakeLists builds exactly this way when SYSTEM_STK is off.
+    #
+    # The exclusions are upstream's, not invented here: Rt* is RtAudio and
+    # RtMidi, and Inet/Socket/Tcp/Udp/Thread/Mutex/Messager are the
+    # platform plumbing a UGen never reaches. What is left is DSP.
+    #
+    # The instruments read `rawwaves/*.raw` at runtime — 45 files, 348 KB —
+    # and StkInst takes the path as a UGen argument rather than baking one
+    # in, so they are shipped into the page's filesystem by
+    # tools/build-audio-assets.mjs rather than compiled in.
+    if(EXISTS "${SC3_PLUGINS_DIR}/../external_libraries/stk/include/Stk.h")
+        set(STK_DIR "${SC3_PLUGINS_DIR}/../external_libraries/stk")
+        file(GLOB stk_srcs "${STK_DIR}/src/*.cpp")
+        file(GLOB stk_drop
+            "${STK_DIR}/src/Rt*.cpp" "${STK_DIR}/src/Inet*.cpp"
+            "${STK_DIR}/src/Socket.cpp" "${STK_DIR}/src/Tcp*.cpp"
+            "${STK_DIR}/src/UdpSocket.cpp" "${STK_DIR}/src/Thread.cpp"
+            "${STK_DIR}/src/Mutex.cpp" "${STK_DIR}/src/Messager.cpp")
+        list(REMOVE_ITEM stk_srcs ${stk_drop})
+        # ONE archive for the library, shared by both plugins: compiling
+        # eighty files twice would be eighty duplicate symbols as well as
+        # twice the work.
+        add_library(sc3_stklib ${TYPE} ${stk_srcs})
+        target_include_directories(sc3_stklib PUBLIC
+            "${STK_DIR}" "${STK_DIR}/include" "${STK_DIR}/src/include")
+        target_link_libraries(sc3_stklib PRIVATE plugin_common)
+        foreach(stk_plugin StkUGens StkInst)
+            if(stk_plugin STREQUAL "StkUGens")
+                set(stk_src "${SC3_PLUGINS_DIR}/StkUGens/StkAll.cpp")
+            else()
+                set(stk_src "${SC3_PLUGINS_DIR}/StkInst/StkInst.cpp")
+            endif()
+            add_library(sc3_${stk_plugin} ${TYPE} "${stk_src}")
+            target_link_libraries(sc3_${stk_plugin} PRIVATE plugin_common sc3_stklib)
+            target_include_directories(sc3_${stk_plugin} PRIVATE
+                "${SC3_PLUGINS_DIR}/${stk_plugin}")
+            # `gWorld` as well as `ft`: StkInst.cpp and OteyPiano.cpp
+            # both define it, two plugins with one global between them.
+            set_source_files_properties("${stk_src}" PROPERTIES
+                COMPILE_DEFINITIONS "ft=sc3_ft_${stk_plugin};gWorld=sc3_gWorld_${stk_plugin}")
+            list(APPEND plugins sc3_${stk_plugin})
+        endforeach()
+        set(SC3_STK_BUILT TRUE)
+    else()
+        message(STATUS "sc3-plugins: no vendored stk - StkUGens and StkInst left out")
+        set(SC3_STK_BUILT FALSE)
+    endif()
+
+    # E9-29 — the two sets that need fftw, and only when it is built.
+    #
+    # `PitchDetection` carries Tartini, the pitch tracker acrostic, splnkr
+    # and caliper use. Its header picks a backend and there are two:
+    # FFTW, or Apple's vDSP. There is no portable third path to fall back
+    # on, so without fftw these cannot be built at all — which is why they
+    # were the only sets left out for a reason that was not a name clash or
+    # a missing class. norns gets libfftw3 from Debian;
+    # tools/sclang/build-fftw.sh builds ours.
+    if(FFTW3F_LIB AND EXISTS "${FFTW3F_LIB}")
+        message(STATUS "sc3-plugins: fftw3f at ${FFTW3F_LIB}")
+        list(APPEND sc3_plugin_targets
+            "PitchDetection|PitchDetection/PitchDetection.cpp,PitchDetection/Qitch.cpp,PitchDetection/Tartini.cpp"
+            "NCAnalysisUGens|NCAnalysisUGens/LPCAnalysis.cpp,NCAnalysisUGens/LPCAnalyzer.cpp,NCAnalysisUGens/MedianSeparation.cpp,NCAnalysisUGens/NCAnalysis.cpp,NCAnalysisUGens/SMS.cpp,NCAnalysisUGens/TPV.cpp,NCAnalysisUGens/WalshHadamard.cpp,NCAnalysisUGens/WaveletDaub.cpp")
+        set(sc3_fftw_targets PitchDetection NCAnalysisUGens)
+    else()
+        message(STATUS "sc3-plugins: no fftw3f - Tartini, Qitch and NCAnalysis left out")
+        set(sc3_fftw_targets "")
+    endif()
+    foreach(entry ${sc3_plugin_targets})
+        # Commas inside an entry, not semicolons: a semicolon IS CMake's
+        # list separator, so a multi-source entry would be torn apart by
+        # the foreach before this line ever saw it.
+        string(REPLACE "|" ";" parts "${entry}")
+        list(GET parts 0 sc3_name)
+        list(GET parts 1 sc3_srcs_raw)
+        string(REPLACE "," ";" sc3_srcs "${sc3_srcs_raw}")
+        set(sc3_full "")
+        foreach(src ${sc3_srcs})
+            list(APPEND sc3_full "${SC3_PLUGINS_DIR}/${src}")
+        endforeach()
+        add_library(sc3_${sc3_name} ${TYPE} ${sc3_full})
+        target_link_libraries(sc3_${sc3_name} PRIVATE plugin_common)
+        # E9-28: ONE NAME PER TRANSLATION UNIT, because a static link has
+        # one symbol table and these plugins were written for many.
+        #
+        # A plugin says `InterfaceTable* ft;` at file scope. Built as a
+        # shared object — which is how sc3-plugins is built everywhere
+        # else, norns included — each one gets its own. Linked statically,
+        # thirteen of the files added here define that symbol, and so does
+        # SuperCollider's own FFTInterfaceTable.cpp:
+        #
+        #     wasm-ld: error: duplicate symbol: ft
+        #     >>> defined in libsc3_MCLDUGens.a(MCLDFFTUGens.cpp.o)
+        #     >>> defined in libsc3_BhobUGens.a(BhobFFT.cpp.o)
+        #
+        # Most files write `static InterfaceTable* ft;` and never had the
+        # problem; these did not. `-fcommon` was tried first and does
+        # NOTHING here: clang applies it to C only, and these are C++.
+        #
+        # So the name is made unique per file instead. The macro renames
+        # the definition and every use in the same translation unit — SC's
+        # own macros expand to `ft->fRTAlloc(...)`, and a macro's expansion
+        # is rescanned, so those are renamed too and still reach the
+        # variable this file sets in its own `X_Load`. The one place `ft`
+        # is passed rather than dereferenced,
+        # `SCWorld_Allocator alloc(ft, ...)` in MCLDCepstrumUGens.cpp, is
+        # renamed the same way and still passes the same pointer.
+        #
+        # `Mirroring` gets the same treatment: BhobChaos.cpp and
+        # BhobFilt.cpp each define `float Mirroring(float, float, float)`,
+        # two plugins with one helper name between them.
+        # Every name below is one the linker reported twice, each time
+        # because a set keeps its own copy of a helper rather than sharing
+        # one — `evalpoly` is written out in both DWGBowed.cpp and
+        # DWGPlucked.cpp, the psychoacoustic tables `phons`, `contours`,
+        # `eqlbandsizes` and `eqlbandbins` are copied between SCMIRUGens and
+        # BBCut2UGens, and so on. Each file keeps its own, under its own
+        # name. Found by building, not by reading: the list is exactly what
+        # `wasm-ld: error: duplicate symbol` named, and nothing is renamed
+        # on suspicion.
+        set(sc3_uniquify
+            ft Mirroring
+            phons contours eqlbandsizes eqlbandbins
+            evalpoly evalpolyA evalpolyB evalrampedA evalrampedB
+            groupdelay PhaseDelayDerive PhaseIIR ValimakiDispersion
+            complex_divide complex_multiply kill_denormals volcar
+            CircularBuffer CircularBufferBase
+            Nchoose PhaseDelay cmp gWorld)
+        # PER FILE, EXCEPT WHERE A SET SHARES ONE.
+        #
+        # Most sets give every file its own `InterfaceTable* ft`, so a
+        # per-file name is right. OteyPianoUGens does not: `piano.h`
+        # DEFINES it and `dwgs.h`, `hammer.h`, `reverb.h` and `filter.cpp`
+        # say `extern`. Renaming that one per file turns the reference into
+        #
+        #     undefined symbol: sc3_ft_dwgs
+        #
+        # so the set's own name is used there and the four files still
+        # agree with each other, while differing from every other set.
+        # The suffix is the only thing that changes.
+        # Which sets these are was not guessed: it is every set with an
+        # `extern InterfaceTable *ft` anywhere in it, which is the shape
+        # that says "one definition, several users".
+        #
+        # DWGUGens has that `extern` too and is NOT here, because its two
+        # files each `#include "dwglib/DWG.cpp"` and so each carries its
+        # OWN definition: one name per set would make them collide again,
+        # which is what the build said when it was tried.
+        set(sc3_ft_shared_sets OteyPianoUGens PitchDetection NCAnalysisUGens)
+        if(sc3_name IN_LIST sc3_ft_shared_sets)
+            set(one_shared TRUE)
+        else()
+            set(one_shared FALSE)
+        endif()
+        foreach(one_src ${sc3_full})
+            get_filename_component(one_stem "${one_src}" NAME_WE)
+            # A shared set takes the SET's name for every symbol, not just
+            # for `ft`: OteyPianoUGens defines `groupdelay` once, in the
+            # copy of dwglib/DWG.cpp that OteyPiano.cpp includes, and
+            # dwgs.cpp calls it. One name per file breaks that too.
+            if(one_shared)
+                set(one_suffix "${sc3_name}")
+            else()
+                set(one_suffix "${one_stem}")
+            endif()
+            set(one_defs "")
+            foreach(sym ${sc3_uniquify})
+                list(APPEND one_defs "${sym}=sc3_${sym}_${one_suffix}")
+            endforeach()
+            set_source_files_properties("${one_src}" PROPERTIES
+                COMPILE_DEFINITIONS "${one_defs}")
+        endforeach()
+        # Quoted includes find a plugin's own headers next to its .cpp, but
+        # the multi-file sets reach sideways; be explicit.
+        target_include_directories(sc3_${sc3_name} PRIVATE "${SC3_PLUGINS_DIR}/${sc3_name}")
+        if(sc3_name STREQUAL "AYUGens")
+            target_include_directories(sc3_${sc3_name} PRIVATE
+                "${SC3_PLUGINS_DIR}/AYUGens/AY_libayemu/include")
+        endif()
+        if(sc3_name IN_LIST sc3_fftw_targets)
+            target_include_directories(sc3_${sc3_name} PRIVATE "${FFTW3F_INCLUDE}")
+            target_link_libraries(sc3_${sc3_name} PRIVATE "${FFTW3F_LIB}")
+        endif()
+        list(APPEND plugins sc3_${sc3_name})
+    endforeach()
+
+    # The Faust pair, each compiled through its wrapper. The include path
+    # has to reach BOTH the wrapper's own directory and the plugin's, since
+    # the wrapper does `#include "JPverbRaw.cpp"`.
+    if(SC3_FAUST_WRAPPER_DIR AND EXISTS "${SC3_FAUST_WRAPPER_DIR}")
+        foreach(faust_name JPverbRaw GreyholeRaw)
+            add_library(sc3_${faust_name} ${TYPE}
+                "${SC3_FAUST_WRAPPER_DIR}/${faust_name}_static.cpp")
+            target_link_libraries(sc3_${faust_name} PRIVATE plugin_common)
+            target_include_directories(sc3_${faust_name} PRIVATE
+                "${SC3_PLUGINS_DIR}/DEINDUGens"
+                "${SC3_PLUGINS_DIR}/DEINDUGens/include")
+            list(APPEND plugins sc3_${faust_name})
+        endforeach()
+    endif()
+endif()

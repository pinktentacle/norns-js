+# --- norns-js: mi-UGens, compiled IN ------------------------------------
+#
+# The Mutable Instruments ports (github.com/v7b1/mi-UGens). A SEPARATE pack
+# from sc3-plugins with its own layout: one CMake project per UGen under
+# `projects/`, each listing the subset of the vendored `eurorack` tree it
+# needs. Its own build makes shared MODULES, which wasm cannot dlopen, so
+# the source lists are reproduced here as static libraries.
+#
+# Five of the twelve. `mi-eng`'s five scripts are one engine each and two of
+# Pedalboard's pedals use MiClouds and MiRings. MiBraids is the one that
+# `#include "samplerate.h"`: it runs its oscillator at a fixed 96 kHz and
+# resamples down to whatever the server is at, so it needs a converter that
+# SuperCollider does not vendor. mi-UGens carries libsamplerate as its own
+# submodule, and that is what is built below.
+#
+# STMLIB IS BUILT ONCE. Every project's CMakeLists lists the same three
+# files -- `dsp/atan.cc`, `dsp/units.cc`, `utils/random.cc` -- which is fine
+# when each becomes its own loadable module and is a duplicate-symbol
+# collision when five static libraries go into one binary. One shared target
+# instead; the plugins' own DSP stays per-plugin, where C++ namespaces
+# (braids::, plaits::, rings::, clouds::, elements::) keep it apart.
+#
+# `-DTEST` is upstream's own switch for "no ARM assembly", which is what
+# makes this buildable for wasm at all.
+if(MI_UGENS_DIR AND EXISTS "${MI_UGENS_DIR}")
+    message(STATUS "mi-UGens: building from ${MI_UGENS_DIR}")
+    set(MI_EURORACK "${MI_UGENS_DIR}/eurorack")
+
+    add_library(mi_stmlib ${TYPE}
+        "${MI_EURORACK}/stmlib/dsp/atan.cc"
+        "${MI_EURORACK}/stmlib/dsp/units.cc"
+        "${MI_EURORACK}/stmlib/utils/random.cc")
+    target_compile_definitions(mi_stmlib PUBLIC TEST)
+    target_include_directories(mi_stmlib PUBLIC "${MI_EURORACK}")
+    target_link_libraries(mi_stmlib PRIVATE plugin_common)
+
+    # LIBSAMPLERATE, AND ONLY THE CONVERTER MiBraids ASKS FOR.
+    #
+    # Its own CMake runs feature probes (endianness, float-to-int clipping,
+    # symbol visibility) to produce a `config.h`. None of those are open
+    # questions for wasm32, and running a second CMake project inside this
+    # one to answer them would also build its tests and its shared library.
+    # So the header is written out here, with the answers stated.
+    #
+    # ENABLE_SINC_FAST_CONVERTER AND NOTHING ELSE. The three sinc converters
+    # differ only in the size of their coefficient table, and the table is a
+    # static array compiled in: fastest is 73 KB of source, medium 614 KB,
+    # best 9304 KB. `MiBraids.cpp:148` sets `SRC_SINC_FASTEST` and never
+    # offers the others, so enabling them would compile 9.9 MB of tables
+    # into the wasm for a quality setting nothing can select. `src_sinc.c`
+    # includes each table behind its own guard, which is what makes this
+    # work.
+    set(MI_SR_DIR "${MI_UGENS_DIR}/projects/MiBraids/libsamplerate")
+    if(EXISTS "${MI_SR_DIR}/src/samplerate.c")
+        set(MI_SR_CONFIG "${CMAKE_CURRENT_BINARY_DIR}/mi_samplerate_config")
+        file(WRITE "${MI_SR_CONFIG}/config.h" [[
+/* Written by the norns-js patch, in place of libsamplerate's own CMake. */
+#define PACKAGE "libsamplerate"
+#define VERSION "0.2.2"
+/* wasm32 traps on an out-of-range float-to-int conversion rather than
+   saturating, so the explicit range checks must stay in. */
+#define CPU_CLIPS_NEGATIVE 0
+#define CPU_CLIPS_POSITIVE 0
+#define CPU_IS_BIG_ENDIAN 0
+#define CPU_IS_LITTLE_ENDIAN 1
+#define HAVE_LRINT 1
+#define HAVE_LRINTF 1
+#define HAVE_STDBOOL_H 1
+#define HAVE_STDINT_H 1
+#define HAVE_UNISTD_H 1
+#define SIZEOF_INT 4
+#define SIZEOF_LONG 4
+/* The fastest sinc converter only -- see the comment in CMakeLists. */
+#define ENABLE_SINC_FAST_CONVERTER
+]])
+        add_library(mi_samplerate ${TYPE}
+            "${MI_SR_DIR}/src/samplerate.c"
+            "${MI_SR_DIR}/src/src_linear.c"
+            "${MI_SR_DIR}/src/src_sinc.c"
+            "${MI_SR_DIR}/src/src_zoh.c")
+        # HAVE_CONFIG_H, or the header above is never read: every source
+        # opens with `#ifdef HAVE_CONFIG_H / #include "config.h"`, and
+        # without it the build gets as far as `bool` and `PACKAGE` being
+        # undeclared -- two symptoms of one missing switch.
+        target_compile_definitions(mi_samplerate PRIVATE HAVE_CONFIG_H)
+        target_include_directories(mi_samplerate PUBLIC
+            "${MI_SR_DIR}/include" "${MI_SR_CONFIG}")
+        set(mi_braids_entry
+            "MiBraids|braids|analog_oscillator.cc,digital_oscillator.cc,macro_oscillator.cc,quantizer.cc,resources.cc")
+    else()
+        message(STATUS "mi-UGens: no libsamplerate submodule, MiBraids skipped")
+        set(mi_braids_entry "")
+    endif()
+
+    set(mi_ugen_targets
+        "MiElements|elements|dsp/exciter.cc,dsp/multistage_envelope.cc,dsp/ominous_voice.cc,dsp/part.cc,dsp/resonator.cc,dsp/string.cc,dsp/tube.cc,dsp/voice.cc,resources.cc"
+        "MiRings|rings|dsp/fm_voice.cc,dsp/part.cc,dsp/resonator.cc,dsp/string.cc,dsp/string_synth_part.cc,resources.cc"
+        "MiClouds|clouds|dsp/correlator.cc,dsp/granular_processor.cc,dsp/mu_law.cc,dsp/pvoc/frame_transformation.cc,dsp/pvoc/phase_vocoder.cc,dsp/pvoc/stft.cc,resources.cc"
+        "MiPlaits|plaits|dsp/chords/chord_bank.cc,dsp/engine/additive_engine.cc,dsp/engine/bass_drum_engine.cc,dsp/engine/chord_engine.cc,dsp/engine/fm_engine.cc,dsp/engine/grain_engine.cc,dsp/engine/hi_hat_engine.cc,dsp/engine/modal_engine.cc,dsp/engine/noise_engine.cc,dsp/engine/particle_engine.cc,dsp/engine/snare_drum_engine.cc,dsp/engine/speech_engine.cc,dsp/engine/string_engine.cc,dsp/engine/swarm_engine.cc,dsp/engine/virtual_analog_engine.cc,dsp/engine/waveshaping_engine.cc,dsp/engine/wavetable_engine.cc,dsp/engine2/chiptune_engine.cc,dsp/engine2/phase_distortion_engine.cc,dsp/engine2/six_op_engine.cc,dsp/engine2/string_machine_engine.cc,dsp/engine2/virtual_analog_vcf_engine.cc,dsp/engine2/wave_terrain_engine.cc,dsp/fm/algorithms.cc,dsp/fm/dx_units.cc,dsp/physical_modelling/modal_voice.cc,dsp/physical_modelling/resonator.cc,dsp/physical_modelling/string.cc,dsp/physical_modelling/string_voice.cc,dsp/speech/lpc_speech_synth.cc,dsp/speech/lpc_speech_synth_controller.cc,dsp/speech/lpc_speech_synth_phonemes.cc,dsp/speech/lpc_speech_synth_words.cc,dsp/speech/naive_speech_synth.cc,dsp/speech/sam_speech_synth.cc,dsp/voice.cc,resources.cc"
+        # E9-36 — four more of the twelve. `terrarium` wants MiRipples and
+        # MiVerb; MiMu and MiOmi cost one translation unit each and are
+        # here for parity with the pack.
+        #
+        # MIBEADS IS NOT HERE AND CANNOT BE: terrarium asks for it, and
+        # there is no MiBeads in v7b1/mi-UGens — not in our checkout and
+        # not upstream, which the GitHub contents API was asked directly.
+        # terrarium installs from a `norns-mi-UGens` release built
+        # elsewhere; whatever that carries, this pack does not.
+        #
+        # MiRipples and MiVerb are their own shape: header-only beside one
+        # `.cpp`, with their includes inside the project rather than in
+        # `eurorack`. They take an empty source list and an extra include
+        # directory below.
+        # E9-38 — MiBeads, which `terrarium` asks for and which E9-36 said
+        # could not be built. That was wrong, and the correction is worth
+        # recording: there is no MiBeads in v7b1/mi-UGens' MAIN, which is
+        # all that was checked — it lives in PULL REQUEST #24, still open.
+        # `patches/mi-UGens.patch` is that PR, applied.
+        "MiBeads|beads|dsp/delay_clock.cc,dsp/delay_controller.cc,dsp/mu_law.cc,dsp/processor.cc,dsp/synth.cc,dsp/trigger_generator.cc,resources.cc"
+        # E9-58 — the last three of the thirteen in this checkout. They were
+        # left out for want of a caller, not for want of a way: each one is
+        # the plain shape the loop above already takes. MiGrids reaches
+        # across into `avrlib` for its PRNG, which is a relative path rather
+        # than a second entry — its own CMakeLists does the same with two
+        # variables.
+        "MiTides|tides2|poly_slope_generator.cc,ramp_extractor.cc,resources.cc"
+        "MiWarps|warps|dsp/filter_bank.cc,dsp/modulator.cc,dsp/oscillator.cc,dsp/vocoder.cc,resources.cc"
+        "MiGrids|grids|clock.cc,pattern_generator.cc,resources.cc,../avrlib/random.cc"
+    )
+    if(mi_braids_entry)
+        list(APPEND mi_ugen_targets "${mi_braids_entry}")
+    endif()
+    foreach(entry ${mi_ugen_targets})
+        # Commas inside an entry, as in the sc3 block above: a semicolon is
+        # CMake's own list separator and would tear an entry apart.
+        string(REPLACE "|" ";" parts "${entry}")
+        list(GET parts 0 mi_name)
+        list(GET parts 1 mi_dir)
+        list(GET parts 2 mi_srcs_raw)
+        string(REPLACE "," ";" mi_srcs "${mi_srcs_raw}")
+        set(mi_full "${MI_UGENS_DIR}/projects/${mi_name}/${mi_name}.cpp")
+        foreach(src ${mi_srcs})
+            list(APPEND mi_full "${MI_EURORACK}/${mi_dir}/${src}")
+        endforeach()
+        add_library(mi_${mi_name} ${TYPE} ${mi_full})
+        target_compile_definitions(mi_${mi_name} PRIVATE TEST)
+        target_include_directories(mi_${mi_name} PRIVATE "${MI_EURORACK}")
+        target_link_libraries(mi_${mi_name} PRIVATE plugin_common mi_stmlib)
+        list(APPEND plugins mi_${mi_name})
+    endforeach()
+
+    # E9-36 — four projects with a shape of their own.
+    #
+    # The loop above takes a project whose extra sources live in
+    # `eurorack/<dir>`. These four do not: MiRipples carries a vendored VCV
+    # Rack tree, MiVerb its own `include/`, MiOmi its own `mi/`, and MiMu is
+    # one file. Bending the loop to cover them would have made it describe
+    # none of them clearly, so they are listed with what they actually need.
+    #
+    # MIBEADS IS NOT HERE AND CANNOT BE: `terrarium` asks for it, and there
+    # is no MiBeads in v7b1/mi-UGens — not in this checkout and not
+    # upstream, which the GitHub contents API was asked directly. terrarium
+    # installs from a `norns-mi-UGens` release built elsewhere.
+    set(mi_own
+        "MiRipples|"
+        "MiVerb|"
+        "MiMu|"
+        "MiOmi|mi/omi/dsp/multistage_envelope.cc,mi/omi/dsp/ominous_voice.cc,mi/omi/dsp/part.cc,mi/omi/resources.cc")
+    foreach(entry ${mi_own})
+        string(REPLACE "|" ";" parts "${entry};")
+        list(GET parts 0 mi_name)
+        list(LENGTH parts mi_n)
+        set(mi_extra_srcs "")
+        if(mi_n GREATER 1)
+            list(GET parts 1 mi_raw)
+            string(REPLACE "," ";" mi_extra_srcs "${mi_raw}")
+        endif()
+        set(mi_full "${MI_UGENS_DIR}/projects/${mi_name}/${mi_name}.cpp")
+        foreach(src ${mi_extra_srcs})
+            list(APPEND mi_full "${MI_UGENS_DIR}/projects/${mi_name}/${src}")
+        endforeach()
+        add_library(mi_${mi_name} ${TYPE} ${mi_full})
+        target_compile_definitions(mi_${mi_name} PRIVATE TEST)
+        target_link_libraries(mi_${mi_name} PRIVATE plugin_common mi_stmlib)
+        target_include_directories(mi_${mi_name} PRIVATE
+            "${MI_EURORACK}"
+            "${MI_UGENS_DIR}/projects/${mi_name}"
+            "${MI_UGENS_DIR}/projects/${mi_name}/include"
+            "${MI_UGENS_DIR}/projects/${mi_name}/mi"
+            "${MI_UGENS_DIR}/projects/${mi_name}/vcvrack"
+            "${MI_UGENS_DIR}/projects/${mi_name}/vcvrack/include"
+            # MiRipples includes <simde/x86/sse4.2.h>: SIMD-everywhere, VCV
+            # Rack's portable stand-in for the x86 intrinsics. It is exactly
+            # the right thing for wasm, and it lives one level up from the
+            # name in the include.
+            "${MI_UGENS_DIR}/projects/${mi_name}/vcvrack/dep")
+        list(APPEND plugins mi_${mi_name})
+    endforeach()
+    # MiBraids is the only one of the five with a dependency of its own.
+    # The include directories ride along: they are PUBLIC on mi_samplerate.
+    if(TARGET mi_MiBraids)
+        target_link_libraries(mi_MiBraids PRIVATE mi_samplerate)
+    endif()

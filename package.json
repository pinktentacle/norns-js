{
  "name": "norns-js",
  "private": true,
  "type": "module",
  "description": "norns in the browser",
  "dependencies": {
    "ace-builds": "^1.45.2",
    "supersonic-scsynth": "^0.95.1",
    "supersonic-scsynth-core": "^0.95.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "fengari": "^0.1.5",
    "wasmoon": "^1.16.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "license": "AGPL-3.0-or-later",
  "desktopName": "norns-js.desktop",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "api": "node tools/extract-api.mjs",
    "api:write": "node tools/extract-api.mjs --write",
    "lua": "bash tools/lua53/build.sh",
    "pins": "node tools/pins.mjs --write",
    "pins:check": "node tools/pins.mjs --check",
    "hardware": "node tools/hardware-report.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dust": "node tools/build-dust.mjs --write",
    "fonts": "node tools/extract-fonts.mjs --write",
    "clock": "node tools/build-clock-worklet.mjs --write",
    "audio": "node tools/build-audio-assets.mjs --write",
    "ugens": "node tools/build-ugen-list.mjs --write",
    "assets": "npm run fonts && npm run clock && npm run dust && npm run audio && npm run ugens",
    "crone:commands": "node tools/extract-crone-commands.mjs",
    "crone:check": "node tools/extract-crone-commands.mjs --check && node tools/extract-crone-lua.mjs",
    "crone:build": "bash src/crone/build.sh",
    "crone:worklet": "node tools/build-crone-worklet.mjs --write",
    "crone:lua": "node tools/extract-crone-lua.mjs --write",
    "desktop": "electron desktop/main.js",
    "desktop:probe": "electron desktop/main.js --probe",
    "desktop:icon": "electron desktop/make-icon.mjs",
    "desktop:payload": "node tools/build-portable.mjs desktop/payload",
    "desktop:dist": "npm run desktop:payload && electron-builder --win",
    "desktop:deck": "npm run desktop:payload && electron-builder --linux",
    "notices": "node tools/build-notices.mjs",
    "notices:check": "node tools/build-notices.mjs --check",
    "licences": "node tools/audit-licences.mjs",
    "licences:check": "node tools/audit-licences.mjs --check",
    "blockers": "node tools/build-blockers.mjs"
  },
  "main": "desktop/main.js",
  "version": "0.1.14",
  "author": "pinktentacle",
  "homepage": "https://norns-js.pages.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pinktentacle/norns-js.git"
  }
}
